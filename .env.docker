# Docker-specific environment variables
# Used ONLY when running via docker-compose
# DO NOT commit real secrets — replace values before deploying

# --- Database (Docker service name, not localhost) ---
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/pos_db

# --- Redis (Docker service name, not localhost) ---
REDIS_HOST=redis
REDIS_PORT=6379

# --- JWT ---
JWT_SECRET=supersecretkey_change_me

# --- API Backend ---
# PORT is handled via docker-compose environment to prevent conflicts

# --- Frontend (used at build time for NEXT_PUBLIC_* vars) ---
# CRITICAL: FRONTEND_URL must match the host browsers use to reach the frontend.
# For mobile testing, use your LAN IP (192.168.1.33) instead of 127.0.0.1.
NEXT_PUBLIC_API_URL=/api/v1
NEXT_PUBLIC_API_WS_URL=http://192.168.1.33:3001
FRONTEND_URL=http://192.168.1.33:3000
CORS_ORIGINS=http://192.168.1.33:3000,http://localhost:3000,http://127.0.0.1:3000

# --- Internal API (for server-side calls inside Docker network, if SSR ever added) ---
INTERNAL_API_URL=http://api:3001/api/v1

# Phase 1 POS SaaS Extensions
GUEST_ORDERING_ENABLED=true
POS_SESSION_ENABLED=true
ANALYTICS_ENABLED=true
PAYMENT_PROVIDER=MOCK
DEFAULT_REGION=TR
ALLOW_TENANT_RESET=true
